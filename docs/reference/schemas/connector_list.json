{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorList",
  "description": "Answer of `GET /v1/connectors`: sorted by context, then name.",
  "type": "object",
  "properties": {
    "connectors": {
      "description": "The connectors.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConnectorStatus"
      }
    }
  },
  "required": [
    "connectors"
  ],
  "$defs": {
    "Capabilities": {
      "description": "What a kind of connector can do. `loom` and the app use this to know what to offer.",
      "type": "object",
      "properties": {
        "mirror": {
          "description": "The connector has a mirror of each issue.",
          "type": "boolean"
        },
        "pool": {
          "description": "The connector has a team pool.",
          "type": "boolean"
        }
      },
      "required": [
        "pool",
        "mirror"
      ]
    },
    "ConnectorCounts": {
      "description": "The counts of the last poll that was not stopped.",
      "type": "object",
      "properties": {
        "failed": {
          "description": "The items and lists that failed.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "listed": {
          "description": "The items of the last poll. For a forge: the updates and the failures of the poll. This\nis not the number of MRs that wait on me.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "local_changes": {
          "description": "The mirrors with local changes.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "pool": {
          "description": "The items of the team pool.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "truncated": {
          "description": "The pool has more items than `pool_limit`.",
          "type": "boolean"
        }
      },
      "required": [
        "listed",
        "pool",
        "failed",
        "truncated",
        "local_changes"
      ]
    },
    "ConnectorFailure": {
      "description": "An item or a list that failed in a poll that went on.",
      "type": "object",
      "properties": {
        "key": {
          "description": "The key of the item, or `list:<name>` for a list.",
          "type": "string"
        },
        "reason": {
          "description": "Why, for humans. Never contains a secret.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "reason"
      ]
    },
    "ConnectorHealth": {
      "description": "The result of the last poll of a connector.",
      "oneOf": [
        {
          "description": "No poll ran since loomd started, or another machine polls this connector.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "not_polled_yet"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "The last poll reported no failure.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "ok"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "description": "Some items or lists failed. The others are applied.",
          "type": "object",
          "properties": {
            "failed": {
              "description": "What failed.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConnectorFailure"
              }
            },
            "state": {
              "type": "string",
              "const": "partial"
            }
          },
          "required": [
            "state",
            "failed"
          ]
        },
        {
          "description": "The host limits the rate of requests.",
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "rate_limited"
            },
            "until": {
              "description": "When the next poll can run.",
              "$ref": "#/$defs/Timestamp"
            }
          },
          "required": [
            "state",
            "until"
          ]
        },
        {
          "description": "The host refuses a secret, or the secret does not resolve.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why, for humans. Never contains the token that loomd has. When `token_cmd` fails,\ncontains the end of the standard error of the command.",
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "credential"
            },
            "which": {
              "description": "The secret.",
              "$ref": "#/$defs/Secret"
            }
          },
          "required": [
            "state",
            "which",
            "error"
          ]
        },
        {
          "description": "The secrets are good, but a permission is missing.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why, for humans. Never contains a secret.",
              "type": "string"
            },
            "failed": {
              "description": "What else failed, when the poll went on.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConnectorFailure"
              }
            },
            "state": {
              "type": "string",
              "const": "forbidden"
            }
          },
          "required": [
            "state",
            "error"
          ]
        },
        {
          "description": "The host refuses the filter of the configuration. A retry does not help.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why, for humans.",
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "invalid_filter"
            }
          },
          "required": [
            "state",
            "error"
          ]
        },
        {
          "description": "The poll stopped for another reason.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Why, for humans. Never contains a secret.",
              "type": "string"
            },
            "failures": {
              "description": "The failed polls in a row.",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "unreachable"
            }
          },
          "required": [
            "state",
            "error",
            "failures"
          ]
        }
      ]
    },
    "ConnectorKind": {
      "description": "The kinds of connector.",
      "oneOf": [
        {
          "description": "A GitLab forge.",
          "type": "string",
          "const": "gitlab"
        },
        {
          "description": "A GitHub forge.",
          "type": "string",
          "const": "github"
        },
        {
          "description": "Datadog.",
          "type": "string",
          "const": "datadog"
        },
        {
          "description": "Jira Cloud.",
          "type": "string",
          "const": "jira"
        },
        {
          "description": "Freshservice.",
          "type": "string",
          "const": "freshservice"
        }
      ]
    },
    "ConnectorStatus": {
      "description": "The status of one connector instance or forge credential.",
      "type": "object",
      "properties": {
        "capabilities": {
          "description": "What its kind can do.",
          "$ref": "#/$defs/Capabilities"
        },
        "context": {
          "description": "The context.",
          "$ref": "#/$defs/ContextName"
        },
        "health": {
          "description": "The result of the last poll.",
          "$ref": "#/$defs/ConnectorHealth"
        },
        "host": {
          "description": "The host of the credential. The API of a forge can be on another host.",
          "type": "string"
        },
        "items": {
          "description": "The counts of the last poll that was not stopped.",
          "$ref": "#/$defs/ConnectorCounts"
        },
        "kind": {
          "description": "Its kind.",
          "$ref": "#/$defs/ConnectorKind"
        },
        "last_attempt": {
          "description": "The start of the last poll on this machine that called the host.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success": {
          "description": "The start of the last poll on this machine that succeeded: the host answered its list and\nthe poll went on, also when each read of an item failed.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "The name of the connector. For a forge: its host.",
          "type": "string"
        },
        "next_poll": {
          "description": "The time of the next poll.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "polled_by": {
          "description": "The machine that polls it.",
          "$ref": "#/$defs/PolledBy"
        },
        "stale": {
          "description": "No poll succeeded in the last 3 poll intervals, or no poll ever succeeded. Always false\nwhen another machine polls the connector.",
          "type": "boolean"
        }
      },
      "required": [
        "context",
        "name",
        "kind",
        "host",
        "polled_by",
        "health",
        "stale",
        "items",
        "capabilities"
      ]
    },
    "ContextName": {
      "description": "Context name: 1 to 64 lowercase ASCII letters, digits and `-`. The first character is a letter. The last character is not `-`.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "PolledBy": {
      "description": "The machine that polls a connector.",
      "oneOf": [
        {
          "description": "This machine: it is the first machine of the context.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "this_machine"
            }
          },
          "required": [
            "by"
          ]
        },
        {
          "description": "Another machine. This machine does not know the health of the connector.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "other"
            },
            "machine": {
              "description": "The first machine of the context.",
              "type": "string"
            }
          },
          "required": [
            "by",
            "machine"
          ]
        },
        {
          "description": "Each machine that holds the context: the context has no `machines` key.",
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "const": "every_machine"
            }
          },
          "required": [
            "by"
          ]
        }
      ]
    },
    "Secret": {
      "description": "A secret of a connector.",
      "oneOf": [
        {
          "description": "The token or the API key.",
          "type": "string",
          "const": "token"
        },
        {
          "description": "The application key of Datadog.",
          "type": "string",
          "const": "app_key"
        }
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with whole seconds, such as 2026-10-12T08:00:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
