{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeEvent",
  "description": "A change in loomd. loomd sends it as one Server-Sent Event: `event:` is its `type`, and\n`data:` is this object as JSON.",
  "oneOf": [
    {
      "description": "A task is new or changed. The change comes from the API, from a hand edit of its file,\nor from a reconciliation.",
      "type": "object",
      "properties": {
        "context": {
          "description": "Context of its store.",
          "$ref": "#/$defs/ContextName"
        },
        "id": {
          "description": "ID of the task.",
          "$ref": "#/$defs/TaskId"
        },
        "type": {
          "type": "string",
          "const": "task.changed"
        }
      },
      "required": [
        "type",
        "id",
        "context"
      ]
    },
    {
      "description": "loomd moved a task to the archive.",
      "type": "object",
      "properties": {
        "context": {
          "description": "Context of its store.",
          "$ref": "#/$defs/ContextName"
        },
        "id": {
          "description": "ID of the task.",
          "$ref": "#/$defs/TaskId"
        },
        "type": {
          "type": "string",
          "const": "task.archived"
        }
      },
      "required": [
        "type",
        "id",
        "context"
      ]
    },
    {
      "description": "A repository of the index is new, changed or removed.",
      "type": "object",
      "properties": {
        "slug": {
          "description": "Slug of the repository, `<context>/<name>`.",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "repo.changed"
        }
      },
      "required": [
        "type",
        "slug"
      ]
    },
    {
      "description": "The number of inbox tasks or waiting tasks of a context changed.",
      "type": "object",
      "properties": {
        "context": {
          "description": "The context.",
          "$ref": "#/$defs/ContextName"
        },
        "inbox": {
          "description": "Tasks in the inbox.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "counts.changed"
        },
        "waiting": {
          "description": "Waiting tasks.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "context",
        "inbox",
        "waiting"
      ]
    },
    {
      "description": "The client cannot get some events: its resume point is too old, it is too far behind, or\nmany changes occurred at the same time. The client gets all the data that it shows again.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resync"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "ContextName": {
      "description": "Context name: 1 to 64 lowercase ASCII letters, digits and `-`. The first character is a letter. The last character is not `-`.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "TaskId": {
      "description": "Task ID: 8 lowercase Crockford base32 characters, such as k3q7zm2a.",
      "type": "string",
      "pattern": "^[0-9a-hjkmnp-tv-z]{8}$"
    }
  }
}
