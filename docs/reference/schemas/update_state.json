{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdateState",
  "description": "Content of `<loom home>/state/update.json`. Every field may be missing (an empty state),\nand unknown fields are ignored, so binaries of different versions share the file.",
  "type": "object",
  "properties": {
    "available": {
      "description": "Newer version found by the last check under the `notify` policy.",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "failed_versions": {
      "description": "Versions that failed the pre-flight check or the watchdog: never applied automatically\nagain.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "last_check": {
      "description": "Instant of the last check, successful or not.",
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_result": {
      "description": "Outcome of the last check or upgrade.",
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending": {
      "description": "Upgrade in progress, from the download to the watchdog's verdict.",
      "anyOf": [
        {
          "$ref": "#/$defs/PendingUpgrade"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "$defs": {
    "PendingUpgrade": {
      "description": "An upgrade in progress.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Version running when the upgrade started.",
          "type": "string"
        },
        "started_at": {
          "description": "Instant the upgrade started (before the download).",
          "$ref": "#/$defs/Timestamp"
        },
        "to": {
          "description": "Version being installed.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "started_at"
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with whole seconds, such as 2026-10-12T08:00:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "UpdateResult": {
      "description": "Outcome of a check or an upgrade.",
      "oneOf": [
        {
          "description": "No newer version.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "up_to_date"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "description": "A newer version exists; the policy is `notify`.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "available"
            },
            "version": {
              "description": "Newer version.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version"
          ]
        },
        {
          "description": "Every newer version is in `failed_versions`.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "skipped_failed"
            },
            "version": {
              "description": "Highest newer version, which failed before.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version"
          ]
        },
        {
          "description": "The new version answered the watchdog: the upgrade is complete.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the verdict.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version replaced.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "upgraded"
            },
            "to": {
              "description": "Version installed.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to"
          ]
        },
        {
          "description": "The staged loomd failed the pre-flight check; nothing was installed.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the verdict.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "preflight_failed"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "version": {
              "description": "Version rejected.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version",
            "message"
          ]
        },
        {
          "description": "The new loomd did not answer the watchdog in time: the previous version was restored.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the rollback.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version restored.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rolled_back"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "to": {
              "description": "Version rejected.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to",
            "message"
          ]
        },
        {
          "description": "An upgrade in progress was abandoned (watchdog killed, machine restarted): found stale.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant it was found stale.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version running when it started.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "interrupted"
            },
            "to": {
              "description": "Version it was installing.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to"
          ]
        },
        {
          "description": "The check or the upgrade failed before any swap: network, verification, install\ndirectory not writable, I/O.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the failure.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "message"
          ]
        }
      ]
    }
  }
}
