{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusResponse",
  "description": "State of a running loomd.",
  "type": "object",
  "properties": {
    "api_version": {
      "description": "API version the daemon serves.",
      "$ref": "#/$defs/ApiVersion"
    },
    "config_path": {
      "description": "Absolute path of the configuration file the daemon loaded.",
      "type": "string"
    },
    "daemon": {
      "description": "Build information of the daemon binary.",
      "$ref": "#/$defs/VersionInfo"
    },
    "loom_home": {
      "description": "Absolute path of the loom home directory the daemon uses.",
      "type": "string"
    },
    "pid": {
      "description": "Process ID of the daemon.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "socket_path": {
      "description": "Absolute path of the unix socket the daemon listens on.",
      "type": "string"
    },
    "started_at": {
      "description": "Instant the daemon started.",
      "$ref": "#/$defs/Timestamp"
    },
    "update": {
      "description": "Auto-upgrade policy and state. Absent from daemons older than this field.",
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uptime_secs": {
      "description": "Whole seconds elapsed since `started_at`.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "api_version",
    "daemon",
    "pid",
    "started_at",
    "uptime_secs",
    "loom_home",
    "socket_path",
    "config_path"
  ],
  "$defs": {
    "ApiVersion": {
      "description": "Version of the loomd API a message belongs to.\n\nA breaking change to any API type adds a variant; compatible changes (new optional fields,\nnew endpoints) keep the current one.",
      "oneOf": [
        {
          "description": "First version of the API.",
          "type": "string",
          "const": "v1"
        }
      ]
    },
    "Channel": {
      "description": "Release channel, set with `LOOM_CHANNEL` at build time.",
      "oneOf": [
        {
          "description": "Tagged release.",
          "type": "string",
          "const": "stable"
        },
        {
          "description": "Prerelease built from every merge to `main`.",
          "type": "string",
          "const": "dev"
        },
        {
          "description": "Any other build, such as `cargo build` on a workstation. Default when `LOOM_CHANNEL` is unset.",
          "type": "string",
          "const": "local"
        }
      ]
    },
    "ChannelSource": {
      "description": "Where the effective release channel comes from.",
      "oneOf": [
        {
          "description": "`[update] channel` of `config.toml`.",
          "type": "string",
          "const": "config"
        },
        {
          "description": "Chosen explicitly with `loom upgrade --channel` (or `install.sh --channel`), kept in\n`state/update.json`.",
          "type": "string",
          "const": "chosen"
        },
        {
          "description": "The channel of the running build.",
          "type": "string",
          "const": "build"
        }
      ]
    },
    "PendingUpgrade": {
      "description": "An upgrade in progress.",
      "type": "object",
      "properties": {
        "from": {
          "description": "Version running when the upgrade started.",
          "type": "string"
        },
        "started_at": {
          "description": "Instant the upgrade started (before the download).",
          "$ref": "#/$defs/Timestamp"
        },
        "to": {
          "description": "Version being installed.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "started_at"
      ]
    },
    "Profile": {
      "description": "Cargo profile family, as reported by Cargo's `PROFILE` build variable.",
      "oneOf": [
        {
          "description": "`dev` or `test` profile, or a custom profile inheriting from them.",
          "type": "string",
          "const": "debug"
        },
        {
          "description": "`release` or `bench` profile, or a custom profile inheriting from them.",
          "type": "string",
          "const": "release"
        }
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with whole seconds, such as 2026-10-12T08:00:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "UpdateChannel": {
      "description": "Release channel loomd follows (`[update] channel`).",
      "oneOf": [
        {
          "description": "Tagged releases only.",
          "type": "string",
          "const": "stable"
        },
        {
          "description": "Tagged releases and dev prereleases.",
          "type": "string",
          "const": "dev"
        }
      ]
    },
    "UpdatePolicyMode": {
      "description": "What loomd does when a newer release exists (`[update] policy`).",
      "oneOf": [
        {
          "description": "Install it, with a pre-flight check and a watchdog that rolls back a failed release.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Record it as available, shown by `loom status`; install nothing.",
          "type": "string",
          "const": "notify"
        },
        {
          "description": "Never check: no network access.",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "UpdateResult": {
      "description": "Outcome of a check or an upgrade.",
      "oneOf": [
        {
          "description": "No newer version.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "up_to_date"
            }
          },
          "required": [
            "kind",
            "at"
          ]
        },
        {
          "description": "A newer version exists; the policy is `notify`.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "available"
            },
            "version": {
              "description": "Newer version.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version"
          ]
        },
        {
          "description": "Every newer version is in `failed_versions`.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the check.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "skipped_failed"
            },
            "version": {
              "description": "Highest newer version, which failed before.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version"
          ]
        },
        {
          "description": "The new version answered the watchdog: the upgrade is complete.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the verdict.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version replaced.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "upgraded"
            },
            "to": {
              "description": "Version installed.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to"
          ]
        },
        {
          "description": "The staged loomd failed the pre-flight check; nothing was installed.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the verdict.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "preflight_failed"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "version": {
              "description": "Version rejected.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "version",
            "message"
          ]
        },
        {
          "description": "The new loomd did not answer the watchdog in time: the previous version was restored.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the rollback.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version restored.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "rolled_back"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            },
            "to": {
              "description": "Version rejected.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to",
            "message"
          ]
        },
        {
          "description": "An upgrade in progress was abandoned (watchdog killed, machine restarted): found stale.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant it was found stale.",
              "$ref": "#/$defs/Timestamp"
            },
            "from": {
              "description": "Version running when it started.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "interrupted"
            },
            "to": {
              "description": "Version it was installing.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "from",
            "to"
          ]
        },
        {
          "description": "The check or the upgrade failed before any swap: network, verification, install\ndirectory not writable, I/O.",
          "type": "object",
          "properties": {
            "at": {
              "description": "Instant of the failure.",
              "$ref": "#/$defs/Timestamp"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "message": {
              "description": "Why.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at",
            "message"
          ]
        }
      ]
    },
    "UpdateStatus": {
      "description": "Update state of a running loomd: its effective configuration and `state/update.json`.",
      "type": "object",
      "properties": {
        "available": {
          "description": "Newer version available (`notify`); absent when it is not newer than the daemon.",
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "description": "Effective channel: `[update] channel`, otherwise the channel chosen with\n`loom upgrade --channel`, otherwise the build channel. Absent for a local build without\neither: nothing is checked.",
          "anyOf": [
            {
              "$ref": "#/$defs/UpdateChannel"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_source": {
          "description": "Where `channel` comes from; absent when `channel` is. Optional when reading, so that a\nclient reads a daemon older than this field.",
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "check_interval_secs": {
          "description": "Interval between two checks, in whole seconds, before jitter.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "failed_versions": {
          "description": "Versions never applied automatically again.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_check": {
          "description": "Instant of the last check.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_result": {
          "description": "Outcome of the last check or upgrade.",
          "anyOf": [
            {
              "$ref": "#/$defs/UpdateResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending": {
          "description": "Upgrade in progress.",
          "anyOf": [
            {
              "$ref": "#/$defs/PendingUpgrade"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy": {
          "description": "Effective policy: `[update] policy`, or the default of the build channel.",
          "$ref": "#/$defs/UpdatePolicyMode"
        }
      },
      "required": [
        "policy",
        "check_interval_secs",
        "failed_versions"
      ]
    },
    "VersionInfo": {
      "description": "Build information embedded in a loom binary at compile time.",
      "type": "object",
      "properties": {
        "channel": {
          "description": "Release channel the binary was built for.",
          "$ref": "#/$defs/Channel"
        },
        "commit": {
          "description": "Full git commit hash of the build, or `unknown` outside a git checkout.",
          "type": "string"
        },
        "commit_date": {
          "description": "Committer date of `commit` in strict ISO 8601, or `unknown` outside a git checkout.",
          "type": "string"
        },
        "profile": {
          "description": "Cargo profile the binary was built with.",
          "$ref": "#/$defs/Profile"
        },
        "target": {
          "description": "Target triple the binary was compiled for.",
          "type": "string"
        },
        "version": {
          "description": "Release version: `LOOM_BUILD_VERSION` at build time, otherwise the crate version.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "commit",
        "commit_date",
        "target",
        "channel",
        "profile"
      ]
    }
  }
}
