{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepoList",
  "description": "Repositories of the index, sorted by slug.",
  "type": "object",
  "properties": {
    "repos": {
      "description": "The repositories.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RepoSummary"
      }
    }
  },
  "required": [
    "repos"
  ],
  "$defs": {
    "ContextAssignment": {
      "description": "The context of a repository and the rule that chose it, first match wins:\noverride, host, path, default context, otherwise unassigned.",
      "oneOf": [
        {
          "description": "`[repos.\"<path>\"] context` names the context of this repository.",
          "type": "object",
          "properties": {
            "context": {
              "description": "Assigned context.",
              "$ref": "#/$defs/ContextName"
            },
            "rule": {
              "type": "string",
              "const": "override"
            }
          },
          "required": [
            "rule",
            "context"
          ]
        },
        {
          "description": "An entry of `match.hosts` matches the host and path of the primary remote.",
          "type": "object",
          "properties": {
            "context": {
              "description": "Assigned context.",
              "$ref": "#/$defs/ContextName"
            },
            "pattern": {
              "description": "The matching entry, `host` or `host/path-prefix`, as normalized.",
              "type": "string"
            },
            "rule": {
              "type": "string",
              "const": "host"
            }
          },
          "required": [
            "rule",
            "context",
            "pattern"
          ]
        },
        {
          "description": "An entry of `match.paths` is the longest prefix of the repository path.",
          "type": "object",
          "properties": {
            "context": {
              "description": "Assigned context.",
              "$ref": "#/$defs/ContextName"
            },
            "prefix": {
              "description": "The matching entry, as written in the configuration (before `~` expansion).",
              "type": "string"
            },
            "rule": {
              "type": "string",
              "const": "path"
            }
          },
          "required": [
            "rule",
            "context",
            "prefix"
          ]
        },
        {
          "description": "No rule matches; `default_context` is set.",
          "type": "object",
          "properties": {
            "context": {
              "description": "Assigned context.",
              "$ref": "#/$defs/ContextName"
            },
            "rule": {
              "type": "string",
              "const": "default"
            }
          },
          "required": [
            "rule",
            "context"
          ]
        },
        {
          "description": "No rule matches and no `default_context` is set.",
          "type": "object",
          "properties": {
            "rule": {
              "type": "string",
              "const": "unassigned"
            }
          },
          "required": [
            "rule"
          ]
        }
      ]
    },
    "ContextName": {
      "description": "Context name: 1 to 64 lowercase ASCII letters, digits and `-`, starting with a letter, not ending with `-`.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
    },
    "ForgeKind": {
      "description": "Forge hosting a remote (`[forges.\"<host>\"] kind`).",
      "oneOf": [
        {
          "description": "GitHub or GitHub Enterprise.",
          "type": "string",
          "const": "github"
        },
        {
          "description": "GitLab, hosted or self-managed.",
          "type": "string",
          "const": "gitlab"
        }
      ]
    },
    "LastUpdate": {
      "description": "The last update of a repository, by `loomd` on its schedule or by `POST /v1/repos/sync`.",
      "type": "object",
      "properties": {
        "outcomes": {
          "description": "What happened, in order: the fetch or why there was none, the branch `HEAD` is on, then\nthe default branch when it was moved or could not be. Never empty.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UpdateOutcome"
          }
        },
        "policy": {
          "description": "The update policy it applied.",
          "$ref": "#/$defs/RepoUpdatePolicy"
        },
        "time": {
          "description": "When the update ended.",
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "time",
        "policy",
        "outcomes"
      ]
    },
    "MaybeKnown_Nullable_RepoOperation": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RepoOperation"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_Nullable_Timestamp": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_Nullable_Upstream": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Upstream"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_Nullable_string": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_RepoHead": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "$ref": "#/$defs/RepoHead"
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_Untracked": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "$ref": "#/$defs/Untracked"
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "MaybeKnown_uint64": {
      "description": "A state field that may not have been computed: the time budget ran out, or it could not\nbe read (the reason is in [`RepoState::error`]).\n\nSerialized as `{\"known\": <value>}` or `\"unknown\"`, so that a known `null` (no upstream, no\noperation…) is never confused with an unknown value.",
      "oneOf": [
        {
          "description": "The value.",
          "type": "object",
          "properties": {
            "known": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "known"
          ]
        },
        {
          "description": "Not computed.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "Remote": {
      "description": "A `[remote \"<name>\"]` of a repository.",
      "type": "object",
      "properties": {
        "location": {
          "description": "Normalized location; absent for a local path or a URL loom cannot read.",
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Remote name, such as `origin`.",
          "type": "string"
        },
        "url": {
          "description": "URL as configured, without any password.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ]
    },
    "RemoteUrl": {
      "description": "Network location of a remote, normalized: host lowercased (SSH aliases resolved), user,\ndefault port and `.git` suffix removed, path case kept.",
      "type": "object",
      "properties": {
        "host": {
          "description": "Host name, lowercase, such as `github.com`.",
          "type": "string"
        },
        "path": {
          "description": "Path without leading or trailing `/` and without `.git`, such as `gsuquet/loom`.",
          "type": "string"
        },
        "port": {
          "description": "Port, when not the default of the transport.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "host",
        "path"
      ]
    },
    "RepoHead": {
      "description": "What `HEAD` points to.",
      "oneOf": [
        {
          "description": "A branch with at least one commit.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "name": {
              "description": "Short branch name, such as `main` or `feat/x`.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "A branch without any commit yet (new repository, orphan branch).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unborn"
            },
            "name": {
              "description": "Short branch name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "A commit, outside any branch.",
          "type": "object",
          "properties": {
            "commit": {
              "description": "Abbreviated commit id (`core.abbrev`, at least 7 hexadecimal digits).",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "detached"
            }
          },
          "required": [
            "kind",
            "commit"
          ]
        }
      ]
    },
    "RepoOperation": {
      "description": "A git operation left in progress in the working tree.",
      "oneOf": [
        {
          "description": "`git rebase`, including an interactive one.",
          "type": "string",
          "const": "rebase"
        },
        {
          "description": "`git merge`.",
          "type": "string",
          "const": "merge"
        },
        {
          "description": "`git cherry-pick`.",
          "type": "string",
          "const": "cherry-pick"
        },
        {
          "description": "`git revert`.",
          "type": "string",
          "const": "revert"
        },
        {
          "description": "`git bisect`.",
          "type": "string",
          "const": "bisect"
        },
        {
          "description": "`git am`: patches being applied from a mailbox.",
          "type": "string",
          "const": "am"
        }
      ]
    },
    "RepoState": {
      "description": "The state of a repository, read without starting git, at [`RepoState::refreshed_at`].",
      "type": "object",
      "properties": {
        "default_branch": {
          "description": "Default branch: the target of `refs/remotes/<primary remote>/HEAD`, otherwise `main`,\notherwise `master` when the branch exists; `null` when none of them.",
          "$ref": "#/$defs/MaybeKnown_Nullable_string"
        },
        "dirty": {
          "description": "Tracked paths with a change: modified, staged, deleted, renamed or conflicted\n(untracked files are counted in `untracked`).",
          "$ref": "#/$defs/MaybeKnown_uint64"
        },
        "error": {
          "description": "Why some fields are unknown, in English; `null` when every field is known.",
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "description": "What `HEAD` points to.",
          "$ref": "#/$defs/MaybeKnown_RepoHead"
        },
        "last_commit": {
          "description": "Committer date of `HEAD`'s commit, `null` for an unborn branch.",
          "$ref": "#/$defs/MaybeKnown_Nullable_Timestamp"
        },
        "last_fetch": {
          "description": "Modification time of `FETCH_HEAD`, `null` when the repository was never fetched.",
          "$ref": "#/$defs/MaybeKnown_Nullable_Timestamp"
        },
        "operation": {
          "description": "Operation in progress, `null` when none.",
          "$ref": "#/$defs/MaybeKnown_Nullable_RepoOperation"
        },
        "refreshed_at": {
          "description": "When the state was read.",
          "$ref": "#/$defs/Timestamp"
        },
        "untracked": {
          "description": "Untracked files.",
          "$ref": "#/$defs/MaybeKnown_Untracked"
        },
        "upstream": {
          "description": "Upstream of the `HEAD` branch, `null` when detached, unconfigured, or when its ref is\nmissing (never fetched, or deleted on the remote and pruned).",
          "$ref": "#/$defs/MaybeKnown_Nullable_Upstream"
        }
      },
      "required": [
        "refreshed_at",
        "head",
        "dirty",
        "untracked",
        "operation",
        "upstream",
        "default_branch",
        "last_commit",
        "last_fetch"
      ]
    },
    "RepoSummary": {
      "description": "A repository of the index: its identity and how loom knows it.",
      "type": "object",
      "properties": {
        "context": {
          "description": "Context and the rule that assigned it.",
          "$ref": "#/$defs/ContextAssignment"
        },
        "forge": {
          "description": "Forge of the primary remote's host, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/ForgeKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_update": {
          "description": "Result of the last update (fetch, fast-forward), `null` until the first one.",
          "anyOf": [
            {
              "$ref": "#/$defs/LastUpdate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_used": {
          "description": "Last time the repository was used, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Directory name.",
          "type": "string"
        },
        "path": {
          "description": "Absolute path, as found (symbolic links kept). The key of a repository.",
          "type": "string"
        },
        "primary_remote": {
          "description": "Name of the primary remote: `origin`, otherwise the first one.",
          "type": [
            "string",
            "null"
          ]
        },
        "registered": {
          "description": "Added by `POST /v1/repos/register`: a scan never removes it while it exists on disk.",
          "type": "boolean"
        },
        "remotes": {
          "description": "Every remote, in configuration order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Remote"
          }
        },
        "slug": {
          "description": "`<context>/<name>`, with a numeric suffix (`-2`, `-3`…) when another repository has the\nsame one. `unassigned/<name>` for an unassigned repository.",
          "type": "string"
        },
        "state": {
          "description": "State (the repo card), `null` until it is read for the first time.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepoState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "name",
        "slug",
        "context",
        "remotes",
        "registered"
      ]
    },
    "RepoUpdatePolicy": {
      "description": "How `loomd` updates a repository (`update` of a context or of `[repos.\"<path>\"]`).",
      "oneOf": [
        {
          "description": "Fetch, then fast-forward when it is safe.",
          "type": "string",
          "const": "ff"
        },
        {
          "description": "Fetch only.",
          "type": "string",
          "const": "fetch"
        },
        {
          "description": "Neither fetch nor fast-forward.",
          "type": "string",
          "const": "off"
        }
      ]
    },
    "SkipReason": {
      "description": "Why a step of an update was not done.",
      "oneOf": [
        {
          "description": "Policy `off`: neither fetch nor fast-forward.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "policy_off"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "description": "The repository has no remote to fetch.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "no_remote"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "description": "The repository cannot be opened.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "unreadable"
            },
            "error": {
              "description": "Why, in English.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "error"
          ]
        },
        {
          "description": "A field the decision needs is unknown (time budget exceeded, unreadable).",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "unknown"
            },
            "field": {
              "description": "The field.",
              "$ref": "#/$defs/StateField"
            }
          },
          "required": [
            "code",
            "field"
          ]
        },
        {
          "description": "An operation is in progress.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "operation"
            },
            "operation": {
              "description": "The operation.",
              "$ref": "#/$defs/RepoOperation"
            }
          },
          "required": [
            "code",
            "operation"
          ]
        },
        {
          "description": "Tracked paths are modified, staged or conflicted.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "dirty"
            },
            "paths": {
              "description": "How many.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "code",
            "paths"
          ]
        },
        {
          "description": "`HEAD` is not on a branch.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "detached"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "description": "The branch `HEAD` is on has no commit.",
          "type": "object",
          "properties": {
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "code": {
              "type": "string",
              "const": "unborn"
            }
          },
          "required": [
            "code",
            "branch"
          ]
        },
        {
          "description": "The branch `HEAD` is on has no upstream, or its upstream ref does not exist.",
          "type": "object",
          "properties": {
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "code": {
              "type": "string",
              "const": "no_upstream"
            }
          },
          "required": [
            "code",
            "branch"
          ]
        },
        {
          "description": "The branch has commits its upstream does not have, and the reverse.",
          "type": "object",
          "properties": {
            "ahead": {
              "description": "Commits of the branch not in its upstream.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "behind": {
              "description": "Commits of the upstream not in the branch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "code": {
              "type": "string",
              "const": "diverged"
            }
          },
          "required": [
            "code",
            "branch",
            "ahead",
            "behind"
          ]
        },
        {
          "description": "`git merge --ff-only` refused, such as when an untracked file would be overwritten.",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "merge_refused"
            },
            "stderr_tail": {
              "description": "The end of git's standard error.",
              "type": "string"
            }
          },
          "required": [
            "code",
            "stderr_tail"
          ]
        },
        {
          "description": "The local default branch has commits its upstream does not have, and the reverse.",
          "type": "object",
          "properties": {
            "ahead": {
              "description": "Commits of the branch not in its upstream.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "behind": {
              "description": "Commits of the upstream not in the branch.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "code": {
              "type": "string",
              "const": "default_branch_diverged"
            }
          },
          "required": [
            "code",
            "branch",
            "ahead",
            "behind"
          ]
        }
      ]
    },
    "StateField": {
      "description": "A piece of repository state an update decision needs.",
      "oneOf": [
        {
          "description": "What `HEAD` points to.",
          "type": "string",
          "const": "head"
        },
        {
          "description": "Tracked changes.",
          "type": "string",
          "const": "dirty"
        },
        {
          "description": "Operation in progress.",
          "type": "string",
          "const": "operation"
        },
        {
          "description": "Upstream of the `HEAD` branch.",
          "type": "string",
          "const": "upstream"
        },
        {
          "description": "Commits of `HEAD` not in its upstream.",
          "type": "string",
          "const": "ahead"
        },
        {
          "description": "Commits of the upstream not in `HEAD`.",
          "type": "string",
          "const": "behind"
        },
        {
          "description": "The commits of `HEAD` and of its upstream.",
          "type": "string",
          "const": "commits"
        },
        {
          "description": "The default branch, its upstream and the worktrees that have it checked out.",
          "type": "string",
          "const": "default_branch"
        }
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 instant in UTC with whole seconds, such as 2026-10-12T08:00:00Z.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "Untracked": {
      "description": "Untracked files of the working tree, `.gitignore` applied.",
      "type": "object",
      "properties": {
        "capped": {
          "description": "The count stopped at the cap: there are more.",
          "type": "boolean"
        },
        "count": {
          "description": "Number of untracked files (an untracked nested repository counts as one), at most the\ncap.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "count",
        "capped"
      ]
    },
    "UpdateOutcome": {
      "description": "One result of an update.",
      "oneOf": [
        {
          "description": "The primary remote was fetched; no branch had to move.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fetched"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The branch `HEAD` is on was fast-forwarded to its upstream.",
          "type": "object",
          "properties": {
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "from": {
              "description": "Commit id before (40 or 64 hexadecimal digits).",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "fast_forwarded"
            },
            "to": {
              "description": "Commit id after.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "branch",
            "from",
            "to"
          ]
        },
        {
          "description": "The local default branch, checked out nowhere, was fast-forwarded to its upstream.",
          "type": "object",
          "properties": {
            "branch": {
              "description": "Short branch name.",
              "type": "string"
            },
            "from": {
              "description": "Commit id before.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "default_branch_moved"
            },
            "to": {
              "description": "Commit id after.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "branch",
            "from",
            "to"
          ]
        },
        {
          "description": "A step was not done, on purpose.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skipped"
            },
            "reason": {
              "description": "Why.",
              "$ref": "#/$defs/SkipReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        },
        {
          "description": "A git command failed or timed out.",
          "type": "object",
          "properties": {
            "error": {
              "description": "What went wrong: exit status, timeout, or why git could not start.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            },
            "stderr_tail": {
              "description": "The end of git's standard error, at most 2,000 bytes.",
              "type": "string"
            },
            "step": {
              "description": "The step that failed.",
              "$ref": "#/$defs/UpdateStep"
            }
          },
          "required": [
            "kind",
            "step",
            "error",
            "stderr_tail"
          ]
        }
      ]
    },
    "UpdateStep": {
      "description": "A step of an update that runs git.",
      "oneOf": [
        {
          "description": "`git fetch` of the primary remote.",
          "type": "string",
          "const": "fetch"
        },
        {
          "description": "`git merge --ff-only` of the branch `HEAD` is on.",
          "type": "string",
          "const": "fast_forward"
        },
        {
          "description": "`git fetch <remote> <branch>:<branch>` of the default branch.",
          "type": "string",
          "const": "move_default_branch"
        }
      ]
    },
    "Upstream": {
      "description": "The upstream of the branch `HEAD` is on.",
      "type": "object",
      "properties": {
        "ahead": {
          "description": "Commits of `HEAD` that are not in the upstream.",
          "$ref": "#/$defs/MaybeKnown_uint64"
        },
        "behind": {
          "description": "Commits of the upstream that are not in `HEAD`.",
          "$ref": "#/$defs/MaybeKnown_uint64"
        },
        "name": {
          "description": "Short name of the upstream ref, such as `origin/main`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ahead",
        "behind"
      ]
    }
  }
}
