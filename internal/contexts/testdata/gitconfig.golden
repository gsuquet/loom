# Generated by `loom context gitconfig` from testdata/contexts.toml. Do not edit by hand.
# Order matters: the last matching include wins (remotes < paths, short < long).

# context2: gitlab.example.com
[includeIf "hasconfig:remote.*.url:*@gitlab.example.com:**"]
	path = ~/.config/git/context2.gitconfig
[includeIf "hasconfig:remote.*.url:**/gitlab.example.com/**"]
	path = ~/.config/git/context2.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@gitlab.example.com/**"]
	path = ~/.config/git/context2.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@gitlab.example.com:*/**"]
	path = ~/.config/git/context2.gitconfig

# context1: github.com/your-user
[includeIf "hasconfig:remote.*.url:*@github.com:your-user/**"]
	path = ~/.config/git/context1.gitconfig
[includeIf "hasconfig:remote.*.url:**/github.com/your-user/**"]
	path = ~/.config/git/context1.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@github.com/your-user/**"]
	path = ~/.config/git/context1.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@github.com:*/your-user/**"]
	path = ~/.config/git/context1.gitconfig

# context3: gitlab.com/example-group
[includeIf "hasconfig:remote.*.url:*@gitlab.com:example-group/**"]
	path = ~/.config/git/context3.gitconfig
[includeIf "hasconfig:remote.*.url:**/gitlab.com/example-group/**"]
	path = ~/.config/git/context3.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@gitlab.com/example-group/**"]
	path = ~/.config/git/context3.gitconfig
[includeIf "hasconfig:remote.*.url:**/*@gitlab.com:*/example-group/**"]
	path = ~/.config/git/context3.gitconfig

# context1: ~/context1/
[includeIf "gitdir:~/context1/"]
	path = ~/.config/git/context1.gitconfig

# context2: ~/context2/
[includeIf "gitdir:~/context2/"]
	path = ~/.config/git/context2.gitconfig

# context3: ~/context3/
[includeIf "gitdir:~/context3/"]
	path = ~/.config/git/context3.gitconfig

# context3: ~/context1/nested/context3/
[includeIf "gitdir:~/context1/nested/context3/"]
	path = ~/.config/git/context3.gitconfig
