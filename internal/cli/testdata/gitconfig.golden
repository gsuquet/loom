# Generated by `loom context gitconfig` from testdata/contexts.toml. Do not edit by hand.
# Order matters: the last matching include wins (remotes < paths, short < long).
# Remote URLs match as written in git config: git does not apply url.*.insteadOf
# here, so a remote that matches only once rewritten gets no include (`loom context` warns).

